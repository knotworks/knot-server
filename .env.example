APP_NAME=Knot
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_LOG_LEVEL=debug
APP_URL=https://knot.test

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=knot
DB_DATABASE_LEGACY=knot_legacy
DB_USERNAME=homestead
DB_PASSWORD=secret

TELEGRAM_BOT_TOKEN=

DISABLE_NEW_SIGNUPS=false

BROADCAST_CONNECTION=reverb
BROADCAST_DRIVER=reverb
CACHE_DRIVER=file
SESSION_DRIVER=cookie
QUEUE_DRIVER=database

SESSION_LIFETIME=120
SESSION_DOMAIN='.knot.test'
SANCTUM_STATEFUL_DOMAINS='app.knot.test:3000'

LOG_CHANNEL=single

MEDIA_DISK=r2
MEDIA_TEMPORARY_DISK=media-temp
MEDIA_URL_TTL_MINUTES=15
MEDIA_MAX_FILES_PER_POST=5
MEDIA_MAX_IMAGE_KB=10240
MEDIA_MAX_VIDEO_KB=102400
MEDIA_IMAGE_QUALITY=82
MEDIA_VIDEO_CRF=23
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_REGION=auto


{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "knotworks/knot-server",
    "description": "A self-hosted social network for families and other small groups",
    "keywords": [
        "decentralized",
        "social",
        "network",
        "self-hosted"
    ],
    "license": "BSD-3-Clause",
    "type": "project",
    "require": {
        "php": "^8.3",
        "coliving/laravel-friendships": "^1.4",
        "guzzlehttp/guzzle": "^7.10",
        "laravel/framework": "^13.0",
        "laravel/reverb": "^1.8",
        "laravel/sanctum": "4.x-dev",
        "laravel/tinker": "^3.0",
        "masterminds/html5": "^2.10",
        "symfony/dom-crawler": "^8.0",
        "symfony/http-client": "^8.0",
        "symfony/mailgun-mailer": "^8.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "larastan/larastan": "^3.9",
        "laravel/boost": "^2.3",
        "laravel/pint": "^1.28",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9",
        "pestphp/pest": "^4.4.2",
        "pestphp/pest-plugin-laravel": "^4.1.0",
        "phpunit/phpunit": "12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "NotificationChannels\\Telegram\\": "app/NotificationChannels/Telegram/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        },
        "files": [
            "tests/Utilities/functions.php"
        ]
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true,
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
